11) Prime or not prime numbers
  #include <stdio.h>
int main()
{
    int n,i,c=0;
    scanf("%d",&n);//22
    if(n==1)
    {
        printf("Neither prime nor composite number");
        return 0;
    }
    for(int i=2;i<n/2;i++)
    {
        if(n%i==0)
        {
            c++;
            printf("Not a prime number");
            break;
        }
    }
    if(c==0)
    printf("Number is a prime number");
}    
