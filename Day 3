PATTERNS
 #include<stdio.h>
 int main()
 {
     int n,row,col;
    scanf("%d",&n);
    for(row=0;row<n;row++,printf("\n"))
    {
         for(col=0;col<n-row;col++)
         {
            printf("*");
         }
    }
 }


 #include<stdio.h>
 int main()
 {
    int n,row,col;
     scanf("%d",&n);
     for(row=0;row<n;row++,printf("\n"))
    {
        for(col=0;col<2*row-1;col++)
        {
            printf("*");
        }
     }
 }
3.COMBINATION OF TWO
#include<stdio.h>
int main()
{
    int n,c,r;
    scanf("%d",&n);
    for(r=0;r<n;r++,printf("\n"))
    {
        for(c=0;c<=r-1;c++)
        printf(" ");
        for(c=0;c<n;c++)
        printf("*");
    }
}

4.PATTERN BASE THREE AND TWO
